# --- Required ---
# Supabase: Project Settings -> Database -> Connection string. On Vercel use the "Transaction pooler" (port 6543).
DATABASE_URL=postgres://postgres@localhost:5433/church
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
NEXT_PUBLIC_APP_NAME="GLT Teaching Ministry"
# Your deployed address, used in emails/WhatsApp (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://learn.example.org

# --- Reminders & welcome messages (optional; unconfigured channels are skipped) ---
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>". Required for /api/cron/reminders to run.
CRON_SECRET=
# Email via Resend
RESEND_API_KEY=
EMAIL_FROM="GLT Teaching Ministry <no-reply@yourdomain.org>"
# WhatsApp via Twilio (number in E.164, e.g. +14155238886)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Used to turn local numbers like 0803... into +234803...
DEFAULT_COUNTRY_CODE=234
